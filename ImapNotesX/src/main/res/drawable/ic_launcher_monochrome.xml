<!--
  ImapNotesX adaptive-icon monochrome layer (themed icons, API 33+).
  Vector mirror of art/icons/imapnotesx_monochrome.svg - keep them in sync.
  Single colour line art so the launcher can tint the whole mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#000000"
        android:pathData="M0,9 H108 V28 H0 Z" />
    <path
        android:fillColor="#000000"
        android:pathData="M0,28 H108 V31.5 H0 Z" />

    <!-- fountain pen: cap upper-left, nib lower-right -->
    <group
        android:name="pen"
        android:scaleX="0.95"
        android:scaleY="0.95"
        android:rotation="45"
        android:translateX="54"
        android:translateY="59">
        <path
            android:strokeColor="#000000"
            android:strokeWidth="2.2"
            android:pathData="M-25,-6.4 A3.5,6.4 0 0 0 -25,6.4 H8 L14,4.7 L26,2 Q29,0 26,-2 L14,-4.7 L8,-6.4 Z" />
        <path
            android:strokeColor="#000000"
            android:strokeWidth="2.2"
            android:pathData="M-26.5,-9 H-13.4 V-6.4 H-26.5 Z" />
        <path
            android:strokeColor="#000000"
            android:strokeWidth="2.2"
            android:pathData="M20.4,0 H28.4" />
    </group>

    <!-- pencil: eraser lower-left, lead upper-right -->
    <group
        android:name="pencil"
        android:scaleX="0.95"
        android:scaleY="0.95"
        android:rotation="-45"
        android:translateX="54"
        android:translateY="59">
        <path
            android:strokeColor="#000000"
            android:strokeWidth="2.2"
            android:pathData="M-27.5,-6 H16 L27.5,0 L16,6 H-27.5 A2.5,6 0 0 1 -27.5,-6 Z" />
        <path
            android:strokeColor="#000000"
            android:strokeWidth="2.2"
            android:pathData="M-24.5,-6 V6 M-19.5,-6 V6" />
        <path
            android:fillColor="#000000"
            android:pathData="M21.4,-3.2 L29.6,0 L21.4,3.2 Z" />
    </group>
</vector>
