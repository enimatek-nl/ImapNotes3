<?xml version="1.0" encoding="utf-8"?>
<!--The rows of the editor menu spinners. Their background is deliberate and stays: a spinner
    popup is a window of its own, it does not inherit the colour of the editor strip it opens from.
    (tools:ignore for the Overdraw lint check.)-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/EditorMenuBgColor"
    tools:ignore="Overdraw"
    android:orientation="horizontal"
    android:padding="5dp">

    <!-- The icon and its content description are set by Miscs/EditorMenuAdapter: the entries of
         these popups are icons without a label, so the description is their only accessible name.
         (tools:ignore for the ContentDescription lint check.) -->
    <ImageView
        android:id="@+id/row_icon_dummy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="5dp"
        android:scaleType="center"
        tools:ignore="ContentDescription" />

    <nl.enimatek.imapnotesx.Miscs.NDSpinner
        android:id="@+id/row_spinner_dummy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/EditorMenuBgColor"
        android:visibility="invisible" />
</LinearLayout>